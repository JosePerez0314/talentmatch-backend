# Copy to .env and fill in. Never commit real values.

# 1. MySQL initialization via Docker (read by docker-compose)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# 2. Prisma connection (local host port is 3307), e.g. mysql://USER:PASSWORD@localhost:3307/DATABASE
DATABASE_URL=

# 3. Node / Express core
NODE_ENV=development
PORT=3000
JWT_SECRET=

# 4. External integrations
OPENAI_API_KEY=
CLOUDINARY_URL=
ALLOWED_ORIGINS=http://localhost:5173
